MOCK_MODE=false

# Zero-credit development defaults
TRANSCRIPTION_BACKEND=local
RANKING_BACKEND=local
# For better captions on machines with enough RAM, try base.en
LOCAL_WHISPER_MODEL=tiny.en
LOCAL_WHISPER_DEVICE=cpu
LOCAL_WHISPER_COMPUTE_TYPE=int8

# Optional: keep this for later when you want hosted transcription/ranking
OPENAI_API_KEY=
OPENAI_RANK_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIBE_MODEL=whisper-1

WORK_DIR=./work
AUDIO_CHUNK_SECONDS=1200

CLEANUP_TEMP_AUDIO=true
